{
  "name": "ipe-electron",
  "productName": "ipe-electron",
  "version": "7.3.1",
  "author": {
    "name": "Otfried Cheong",
    "email": "ipe@otfried.org"
  },
  "description": "Electron edition of Ipe",
  "license": "GPL-3.0-only",
  "main": "./dist/main/index.js",
  "scripts": {
    "serve": "bash mkapp.bash && electron-vite dev --outDir=dist",
    "preview": "bash mkapp.bash && electron-vite preview --outDir=dist",
    "build": "bash mkapp.bash && electron-vite build --outDir=dist",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "format": "biome format ./src --write",
    "check": "biome check ./src",
    "fix": "biome check ./src --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/core": "^7.11.2",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron-forge/publisher-github": "^7.5.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.7.7",
    "@types/sortablejs": "^1.15.8",
    "electron": "^34.5.8",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@melloware/coloris": "^0.24.0",
    "sortablejs": "^1.15.3"
  }
}
